exports[`queryBuilder should build query for notebook:nb1 notebook:nb2 -notebook:nb3 hello 1`] = `
{
  "fts": {
    "params": [
      "nb1",
      "nb2",
      "nb3",
      ""hello"",
    ],
    "query": "WITH RECURSIVE notebooks_in_scope(id) AS ( SELECT folders.id FROM folders WHERE id IN ( SELECT id FROM folders WHERE folders.title LIKE ? OR folders.title LIKE ? ) UNION ALL SELECT folders.id FROM folders JOIN notebooks_in_scope ON folders.parent_id=notebooks_in_scope.id ), notebooks_not_in_scope(id) AS ( SELECT folders.id FROM folders WHERE id IN ( SELECT id FROM folders WHERE folders.title LIKE ? ) UNION ALL SELECT folders.id FROM folders JOIN notebooks_not_in_scope ON folders.parent_id=notebooks_not_in_scope.id ) SELECT notes_fts.id, notes_fts.title, offsets(notes_fts) AS offsets, matchinfo(notes_fts, 'pcnalx') AS matchinfo, notes_fts.user_created_time, notes_fts.user_updated_time, notes_fts.is_todo, notes_fts.todo_completed, notes_fts.parent_id FROM notes_fts WHERE 1 AND ROWID IN ( SELECT notes_normalized.ROWID FROM notebooks_in_scope JOIN notes_normalized ON notebooks_in_scope.id=notes_normalized.parent_id ) AND ROWID NOT IN ( SELECT notes_normalized.ROWID FROM notebooks_not_in_scope JOIN notes_normalized ON notebooks_not_in_scope.id=notes_normalized.parent_id ) AND notes_fts MATCH ?",
  },
  "noFts": {
    "params": [
      "nb1",
      "nb2",
      "nb3",
      "%hello%",
      "%hello%",
    ],
    "query": "WITH RECURSIVE notebooks_in_scope(id) AS ( SELECT folders.id FROM folders WHERE id IN ( SELECT id FROM folders WHERE folders.title LIKE ? OR folders.title LIKE ? ) UNION ALL SELECT folders.id FROM folders JOIN notebooks_in_scope ON folders.parent_id=notebooks_in_scope.id ), notebooks_not_in_scope(id) AS ( SELECT folders.id FROM folders WHERE id IN ( SELECT id FROM folders WHERE folders.title LIKE ? ) UNION ALL SELECT folders.id FROM folders JOIN notebooks_not_in_scope ON folders.parent_id=notebooks_not_in_scope.id ) SELECT notes.id, notes.title, notes.user_created_time, notes.user_updated_time, notes.is_todo, notes.todo_completed, notes.parent_id FROM notes WHERE 1 AND ROWID IN ( SELECT notes.ROWID FROM notebooks_in_scope JOIN notes ON notebooks_in_scope.id=notes.parent_id ) AND ROWID NOT IN ( SELECT notes.ROWID FROM notebooks_not_in_scope JOIN notes ON notebooks_not_in_scope.id=notes.parent_id ) AND ( notes.body LIKE ? OR notes.title LIKE ? )",
  },
}
`;

