    "params": [
      "abc",
      "tag1",
    ],
    "query": "WITH RECURSIVE notes_with_INCLUSION_tags AS ( SELECT note_tags.note_id as id FROM note_tags WHERE 1 INTERSECT SELECT note_tags.note_id AS id FROM note_tags WHERE note_tags.tag_id IN ( SELECT tags.id FROM tags WHERE tags.title LIKE ?) ) SELECT notes_fts.id, notes_fts.title, offsets(notes_fts) AS offsets, matchinfo(notes_fts, 'pcnalx') AS matchinfo, notes_fts.user_created_time, notes_fts.user_updated_time, notes_fts.is_todo, notes_fts.todo_completed, notes_fts.parent_id FROM notes_fts WHERE 1 AND ( ROWID IN ( SELECT ROWID FROM notes_normalized WHERE id LIKE ? )) AND ROWID IN ( SELECT notes_normalized.ROWID FROM notes_with_INCLUSION_tags JOIN notes_normalized ON notes_with_INCLUSION_tags.id=notes_normalized.id )",
  },
  "noFts": {
    "params": [
      "abc",
      "tag1",
    ],
    "query": "WITH RECURSIVE notes_with_INCLUSION_tags AS ( SELECT note_tags.note_id as id FROM note_tags WHERE 1 INTERSECT SELECT note_tags.note_id AS id FROM note_tags WHERE note_tags.tag_id IN ( SELECT tags.id FROM tags WHERE tags.title LIKE ?) ) SELECT notes.id, notes.title, notes.user_created_time, notes.user_updated_time, notes.is_todo, notes.todo_completed, notes.parent_id FROM notes WHERE 1 AND ( ROWID IN ( SELECT ROWID FROM notes WHERE id LIKE ? )) AND ROWID IN ( SELECT notes.ROWID FROM notes_with_INCLUSION_tags JOIN notes ON notes_with_INCLUSION_tags.id=notes.id )",
  },
}
`;

