exports[`queryBuilder should build query for -id:abc -notebook:nb1 -tag:tag1 -resource:application/pdf 1`] = `
{
  "fts": {
    "params": [
      "abc",
      "nb1",
      "tag1",
      "application/pdf",
    ],
    "query": "WITH RECURSIVE notebooks_not_in_scope(id) AS ( SELECT folders.id FROM folders WHERE id IN ( SELECT id FROM folders WHERE folders.title LIKE ? ) UNION ALL SELECT folders.id FROM folders JOIN notebooks_not_in_scope ON folders.parent_id=notebooks_not_in_scope.id ), notes_with_EXCLUSION_tags AS ( SELECT note_tags.note_id as id FROM note_tags WHERE 0 UNION SELECT note_tags.note_id AS id FROM note_tags WHERE note_tags.tag_id IN ( SELECT tags.id FROM tags WHERE tags.title LIKE ?) ), notes_with_EXCLUSION_resources AS ( SELECT note_resources.note_id as id FROM note_resources WHERE 0 UNION SELECT note_resources.note_id AS id FROM note_resources WHERE note_resources.is_associated=1 AND note_resources.resource_id IN ( SELECT resources.id FROM resources WHERE resources.mime LIKE ?) ) SELECT notes_fts.id, notes_fts.title, offsets(notes_fts) AS offsets, matchinfo(notes_fts, 'pcnalx') AS matchinfo, notes_fts.user_created_time, notes_fts.user_updated_time, notes_fts.is_todo, notes_fts.todo_completed, notes_fts.parent_id FROM notes_fts WHERE 1 AND ( ROWID IN ( SELECT ROWID FROM notes_normalized WHERE id NOT LIKE ? )) AND ROWID NOT IN ( SELECT notes_normalized.ROWID FROM notebooks_not_in_scope JOIN notes_normalized ON notebooks_not_in_scope.id=notes_normalized.parent_id ) AND ROWID NOT IN ( SELECT notes_normalized.ROWID FROM notes_with_EXCLUSION_tags JOIN notes_normalized ON notes_with_EXCLUSION_tags.id=notes_normalized.id ) AND ROWID NOT IN ( SELECT notes_normalized.ROWID FROM notes_with_EXCLUSION_resources JOIN notes_normalized ON notes_with_EXCLUSION_resources.id=notes_normalized.id )",
  },
  "noFts": {
    "params": [
      "abc",
      "nb1",
      "tag1",
      "application/pdf",
    ],
    "query": "WITH RECURSIVE notebooks_not_in_scope(id) AS ( SELECT folders.id FROM folders WHERE id IN ( SELECT id FROM folders WHERE folders.title LIKE ? ) UNION ALL SELECT folders.id FROM folders JOIN notebooks_not_in_scope ON folders.parent_id=notebooks_not_in_scope.id ), notes_with_EXCLUSION_tags AS ( SELECT note_tags.note_id as id FROM note_tags WHERE 0 UNION SELECT note_tags.note_id AS id FROM note_tags WHERE note_tags.tag_id IN ( SELECT tags.id FROM tags WHERE tags.title LIKE ?) ), notes_with_EXCLUSION_resources AS ( SELECT note_resources.note_id as id FROM note_resources WHERE 0 UNION SELECT note_resources.note_id AS id FROM note_resources WHERE note_resources.is_associated=1 AND note_resources.resource_id IN ( SELECT resources.id FROM resources WHERE resources.mime LIKE ?) ) SELECT notes.id, notes.title, notes.user_created_time, notes.user_updated_time, notes.is_todo, notes.todo_completed, notes.parent_id FROM notes WHERE 1 AND ( ROWID IN ( SELECT ROWID FROM notes WHERE id NOT LIKE ? )) AND ROWID NOT IN ( SELECT notes.ROWID FROM notebooks_not_in_scope JOIN notes ON notebooks_not_in_scope.id=notes.parent_id ) AND ROWID NOT IN ( SELECT notes.ROWID FROM notes_with_EXCLUSION_tags JOIN notes ON notes_with_EXCLUSION_tags.id=notes.id ) AND ROWID NOT IN ( SELECT notes.ROWID FROM notes_with_EXCLUSION_resources JOIN notes ON notes_with_EXCLUSION_resources.id=notes.id )",
  },
}
`;

